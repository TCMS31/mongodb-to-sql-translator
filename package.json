{
  "name": "mongodb-to-sql-translator",
  "version": "1.0.0",
  "description": "Translates MongoDB find() queries into equivalent SQL SELECT statements.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "bench": "ts-node scripts/benchmark.ts"
  },
  "keywords": [
    "mongodb",
    "sql",
    "translator",
    "query",
    "typescript",
    "cli"
  ],
  "author": "Saleem",
  "license": "ISC",
  "dependencies": {
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^4.6.2"
  },
  "types": "dist/index.d.ts",
  "bin": {
    "mongo2sql": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.MD"
  ]
}
